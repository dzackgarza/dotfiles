[Unit]
Description=Hermes Agent Gateway - Messaging Platform Integration
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/home/dzack/.hermes/hermes-agent/venv/bin/python -m hermes_cli.main gateway run
WorkingDirectory=/home/dzack/.hermes
Environment="PATH=/home/dzack/.hermes/hermes-agent/venv/bin:/home/dzack/.hermes/hermes-agent/node_modules/.bin:/usr/bin:/home/dzack/.local/bin:/home/dzack/.cargo/bin:/home/dzack/go/bin:/home/dzack/.npm-global/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/home/dzack/.hermes/hermes-agent/venv"
Environment="HERMES_HOME=/home/dzack/.hermes"
Restart=always
RestartSec=5
RestartForceExitStatus=75
KillMode=mixed
KillSignal=SIGTERM
ExecReload=/bin/kill -USR1 $MAINPID
ExecStopPost=-/home/dzack/.hermes/hermes-agent/venv/bin/python -m gateway.cgroup_cleanup
TimeoutStopSec=210
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
