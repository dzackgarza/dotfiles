[Unit]
Description=GitHub Dashboard dynamic dashboard
After=default.target

[Service]
Type=simple
WorkingDirectory=/home/dzack/gitclones/github-dashboard
ExecStart=/bin/direnv exec /home/dzack/gitclones/github-dashboard /home/dzack/.nvm/versions/node/v25.8.2/bin/npm run dev
Restart=on-failure
RestartSec=5
Environment=HOME=/home/dzack
Environment=PATH=/home/dzack/.nvm/versions/node/v25.8.2/bin:/usr/local/bin:/usr/bin:/bin
Environment=GITHUB_DASHBOARD_SCAN_ROOTS=/home/dzack/gitclones
Environment=PORT=3017

[Install]
WantedBy=default.target
